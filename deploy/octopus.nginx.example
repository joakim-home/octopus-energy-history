# Trusted-network/backend example. Replace OCTOPUS_HOST_IP and the example hostname.
# For untrusted access, place authenticated TLS termination in front of this listener.

server {
    listen OCTOPUS_HOST_IP:80 default_server;
    server_name octopus.example.internal OCTOPUS_HOST_IP;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header X-Frame-Options;
        add_header Content-Security-Policy "frame-ancestors 'self' http://HOME_ASSISTANT_HOST:8123" always;
    }
}

