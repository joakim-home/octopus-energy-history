# Replace NETWORK_INTERFACE and OCTOPUS_HOST_IP before installing this drop-in.
# This optional wait is only needed when nginx binds to a specific host address.

[Unit]
Wants=network-online.target
After=network-online.target

[Service]
ExecStartPre=
ExecStartPre=/usr/bin/timeout 30 /bin/sh -c 'until ip -4 addr show dev NETWORK_INTERFACE | grep -q "inet OCTOPUS_HOST_IP/24"; do sleep 1; done'
ExecStartPre=/usr/sbin/nginx -t -q -g 'daemon on; master_process on;'

