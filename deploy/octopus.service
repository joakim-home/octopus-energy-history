[Unit]
Description=Octopus local energy history
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=octopus
Group=octopus
WorkingDirectory=/opt/octopus/app
Environment=ASPNETCORE_URLS=http://127.0.0.1:8080
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=TZ=Europe/London
Environment=OCTOPUS_DATA_PATH=/var/lib/octopus/dashboard.db
Environment=OCTOPUS_SECRET_KEY_PATH=/var/lib/octopus/secret.key
ExecStart=/opt/octopus/app/JoakimHomeDashboard.Web
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/octopus

[Install]
WantedBy=multi-user.target
