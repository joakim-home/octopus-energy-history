@inject JoakimHomeDashboard.Web.LocalAuthOptions AuthOptions
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <title>@ViewData["Title"] · Octopus</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-page="/Index"><span class="brand-mark">⚡</span><span><strong>OCTOPUS</strong><small>LOCAL ENERGY HISTORY</small></span></a>
        @if (AuthOptions.Disabled || User.Identity?.IsAuthenticated == true)
        {
            <nav>
                <a class="@(ViewData["Page"] as string == "Overview" ? "active" : "")" asp-page="/Index">Overview</a>
                <a class="@(ViewData["Page"] as string == "Year" ? "active" : "")" asp-page="/YearAnalysis">Year Analysis</a>
                <a class="@(ViewData["Page"] as string == "Setup" ? "active" : "")" asp-page="/Setup">Octopus Setup</a>
            </nav>
            @if (!AuthOptions.Disabled)
            {
                <div class="session-actions">
                    <span class="service-state"><i></i>@User.Identity?.Name</span>
                    <form method="post" asp-page="/Account/Logout">
                        <button type="submit" class="quiet-link logout-button">Sign out</button>
                    </form>
                </div>
            }
        }
    </header>
    <main class="shell">@RenderBody()</main>
    <script src="~/lib/echarts/echarts.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
